{
  "name": "gabay",
  "private": true,
  "description": "Gabay: indoor wayfinding for Philippine malls. Root scripts; see README and CLAUDE.md.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "seed": "npm --prefix db/seeds run seed",
    "seed:test": "npm --prefix db/seeds test",
    "staging:seed": "npm --prefix db/seeds run staging:seed",
    "staging:admin": "node tools/staging-admin.js",
    "setup-db": "npm --prefix db/tools run setup-db --",
    "migrate": "npm --prefix db/tools run migrate",
    "db:deploy": "npm --prefix db/tools run deploy --",
    "api:test": "npm --prefix functions test",
    "api:lint": "npm --prefix functions run lint && npm --prefix functions run format:check",
    "lint:structural": "node tools/lint/run.js",
    "test:schema-forms": "node tools/lint/run.js schema-forms",
    "lint:test": "node --test \"tools/lint/test/**/*.test.js\"",
    "verify": "node tools/verify.js",
    "tools:test": "node --test \"tools/test/**/*.test.js\"",
    "ci:guards": "node tools/ci-guards.js",
    "worktree:new": "node tools/worktree-new.js",
    "worktree:remove": "node tools/worktree-remove.js",
    "gen:closed-sets": "node tools/gen-closed-sets.js",
    "gen:venue-map-schema": "node tools/gen-venue-map-schema.js",
    "measure:venue-map": "node tools/measure-venue-map.js",
    "measure:venue-map-save": "node tools/measure-venue-map-save.js",
    "measure:guard-chain": "node tools/measure-guard-chain.js",
    "gcs:check": "node tools/gcs-bucket-check.js"
  }
}
