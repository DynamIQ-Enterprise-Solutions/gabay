# Never in git (plan.html L123; WORKING_AGREEMENT §7)
/Gabay Demo.apk
*.apk
*.aab
/db/seeds/sources/internal/
/db/seeds/sources/spike-exports/*.json

# Secrets: the pre-commit secret guard refuses these too (standard §8.1)
.env
.env.*
!.env.example

# The API's local file store (FILE_STORE_DIR, E-20; OA-2): uploaded images and packages, throwaway data
/.local-files/

# Dependencies and local tool state
node_modules/
.emulator-data/
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
*.log

# Build output (each Flutter project adds its own .gitignore as well)
build/
coverage/
.dart_tool/

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
.DS_Store
Thumbs.db

# Claude Code: per-machine files (settings.json and agents/ are committed, standard §8.6)
.claude/settings.local.json
.claude/*.lock

# npm run verify: the last run's result and the Claude session baselines (L129; tools/fingerprint.js)
.verify/

# Emulator lanes (plan/PH4-lane-ports.md): the per-copy firebase configs, generated by tools/lib/emulator-lane.js
firebase.lane.json

# The admin page's Firebase web config (SEC-3, DC-7): the owner writes app/config/firebase.local.json from the
# "Gabay admin" web app's config on their own machine. Only firebase.example.json (placeholders) is committed.
app/config/*.local.json
