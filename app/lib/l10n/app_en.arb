  "validatorRequired": "{label} is required.",
  "@validatorRequired": {
    "description": "Form validation: a mandatory field is empty. The label is the field's own name.",
    "placeholders": { "label": { "type": "String", "example": "Venue name" } }
  },
  "validatorTooLong": "{label} must be at most {max} characters.",
  "@validatorTooLong": {
    "description": "Form validation: the text is longer than the field allows.",
    "placeholders": {
      "label": { "type": "String", "example": "Code" },
      "max": { "type": "int", "example": "3" }
    }
  },

  "validatorNotInteger": "{label} must be a whole number.",
  "@validatorNotInteger": {
    "description": "Form validation: the text in a whole-number field is not a whole number.",
    "placeholders": { "label": { "type": "String", "example": "Floor" } }
  },
  "validatorDecimalShape": "{label} must be a number written like {example}, with digits on both sides of the point.",
  "@validatorDecimalShape": {
    "description": "Form validation: the text in a decimal-number field is not a number in the accepted form (digits, then optionally a point and more digits; .5 and 5. are refused). The example shows the form with the field's number of places.",
    "placeholders": {
      "label": { "type": "String", "example": "Grid cell size" },
      "example": { "type": "String", "example": "0.50" }
    }
  },
  "validatorDecimalPlaces": "{label} takes at most {places} decimal places.",
  "@validatorDecimalPlaces": {
    "description": "Form validation: the number has more places after the point than the field keeps. Nothing is rounded for the person.",
    "placeholders": {
      "label": { "type": "String", "example": "Grid cell size" },
      "places": { "type": "int", "example": "2" }
    }
  },
  "validatorDecimalDigits": "{label} takes at most {digits} digits before the point.",
  "@validatorDecimalDigits": {
    "description": "Form validation: the number has more digits before the point than the field holds.",
    "placeholders": {
      "label": { "type": "String", "example": "Width" },
      "digits": { "type": "int", "example": "6" }
    }
  },
  "validatorRange": "{kind, select, above{{label} must be greater than {min}.} atLeast{{label} must be at least {min}.} below{{label} must be less than {max}.} atMost{{label} must be at most {max}.} atLeastBelow{{label} must be at least {min} and less than {max}.} atLeastAtMost{{label} must be at least {min} and at most {max}.} aboveBelow{{label} must be greater than {min} and less than {max}.} aboveAtMost{{label} must be greater than {min} and at most {max}.} other{{label} is out of range.}}",
  "@validatorRange": {
    "description": "Form validation: the number is outside the range the field accepts. The kind says which bounds the range has and whether each bound itself is allowed (above and below leave the bound out; at least and at most keep it).",
    "placeholders": {
      "label": { "type": "String", "example": "Map up angle" },
      "kind": { "type": "String", "example": "atLeastBelow" },
      "min": { "type": "String", "example": "0" },
      "max": { "type": "String", "example": "360" }
    }
  },
  "validatorNotEmail": "{label} must be an email address, like name@example.com.",
  "@validatorNotEmail": {
    "description": "Form validation: the text in an email field is not shaped like an email address.",
    "placeholders": { "label": { "type": "String", "example": "Email" } }
  },

