# Gabay — .env.example
# Version 0.1 stub · 2026-10-07 · Phase 0 stub (standard §2; plan.html L115)
# Copy to .env and fill in. The real .env is never committed (the pre-commit hook refuses it, §8.1).
# Keys are added here in the same change that first reads them.

# ---------------------------------------------------------------------------
# Local PostgreSQL (L109, L115). Development only.
# ---------------------------------------------------------------------------
# Host of the local PostgreSQL 18 server.
PGHOST=localhost
# Port (the installer's default).
PGPORT=5432
# Database created in INSTALL.md A.1.
PGDATABASE=gabay_dev
# Superuser for local development only. The API gets its own least-privilege login in Phase 1.
PGUSER=postgres
# The password you chose at install. Never commit a real value.
PGPASSWORD=

# ---------------------------------------------------------------------------
# Emulator lane (plan/PH4-lane-ports.md). A coder's working copy runs its Firebase emulators on the default ports plus this
# offset, so copies verify side by side (functions 5001, auth 9099, hub 4400, logging 4500, eventarc 9299, tasks 9499).
# `npm run worktree:new` writes it into the copy's .env. Without it a copy named after an agent uses its table value
# (api-coder 10, flutter-coder 20, engine-coder 30, native-ble 40, test-verifier 50) and any other folder, the main one
# included, uses 0. A whole number from 0 to 99 (the base ports are at least 100 apart, so a larger offset could meet another lane's port); no two copies may share one. `worktree:new` also sets
# FIREBASE_AUTH_EMULATOR_HOST below to 127.0.0.1:<9099 + this offset> in the copy's .env.
# EMULATOR_PORT_OFFSET=10

# ---------------------------------------------------------------------------
# Test accounts (L119). Local Firebase Auth emulator only. One password per account; never commit real values.
# ---------------------------------------------------------------------------
# superadmin@gabay.test: SuperAdmin (platform).
SEED_PW_SUPERADMIN=
# malladmin@gabay.test: Mall admin of both test tenants (the product owner).
SEED_PW_MALLADMIN=
# editor@gabay.test: Venue editor, both tenants.
SEED_PW_EDITOR=
# viewer@gabay.test: Viewer, both tenants.
SEED_PW_VIEWER=
# malladmin.demo@gabay.test: Mall admin of Demo Malls only (tenant isolation).
SEED_PW_MALLADMIN_DEMO=
# shopper@gabay.test: a signed-in shopper.
SEED_PW_SHOPPER=

# ---------------------------------------------------------------------------
# API (Phase 1, functions/src/config). Read once at start-up and validated with zod: a missing
# required key or a malformed value stops the API with a message naming the key (standard §3.16).
# An empty value counts as "not set". A real environment variable always beats this file.
# ---------------------------------------------------------------------------
# Node environment: development | test | production. Default development.
NODE_ENV=development
# Log level for pino: fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=info
# Origins allowed to call the API: the admin web page's address (E-05). Comma-separated, exact match
# (scheme + host + port). EMPTY allows every origin and the API logs a loud warning at start-up:
# never leave it empty in a deployed environment.
CORS_ORIGINS=http://localhost:5000
# How many reverse-proxy hops sit in front of the API (the client IP is read from that far along
# X-Forwarded-For). Cloud Functions sits behind Google's front end: 1. Default 1. Wrong values make
# req.ip lie, which breaks rate limiting.
TRUST_PROXY_HOPS=1
# Largest JSON request body. Default 5mb; never a blanket 50mb (memory-DoS amplifier). Large files go
# through upload routes, not JSON. Format: a number plus b, kb or mb.
MAX_JSON_BODY=5mb
# Database pool (the PG* keys above say where the database is). All optional.
# Most connections the one function instance opens. Default 10.
PG_POOL_MAX=10
# Close a connection idle this long, in milliseconds. Default 30000.
PG_IDLE_TIMEOUT_MS=30000
# Give up connecting after this long, in milliseconds. Default 5000 (the health check then answers 503).
PG_CONNECT_TIMEOUT_MS=5000
# Longest any one statement may run, in milliseconds. Default 60000: bulk writes and publishes run long.
PG_STATEMENT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Firebase (first deploy, on the product owner's call only; L109). Left empty until then.
# ---------------------------------------------------------------------------
# The Firebase project ID. Empty means the emulators only.
FIREBASE_PROJECT_ID=
# The Firebase Auth emulator, development and tests ONLY: host:port the Admin SDK checks ID tokens against
# (the seed starts it on 127.0.0.1:9099). The SDK then accepts UNSIGNED tokens, so the API refuses to start
# with this set unless NODE_ENV is written explicitly as development or test (NODE_ENV above; an unset NODE_ENV
# does not count). Leave it empty in any deployed environment: tokens are then checked against Google's real
# certificates for FIREBASE_PROJECT_ID. With it set and FIREBASE_PROJECT_ID empty, the project is the emulator's
# demo-gabay. When you run the Functions emulator together with the Auth emulator, it sets this variable itself, so
# NODE_ENV=development must be in .env.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------------
# Development stub (EXCEPTIONS E-20, FF-0). Local development only; removed again by the retrofit's R1.
# ---------------------------------------------------------------------------
# Until the retrofit, admin routes (the lookups, and every feature route after them) run WITHOUT sign-in, as the one admin
# named here: the API looks the AppUser up by email on each request. The default is the mall admin who holds both seeded
# tenants (L154); it must be an active seeded admin with a tenant role (the SUPERADMIN has none). A request may send
# X-Tenant-Id to act for another tenant the user holds; with no header the user's first tenant by code is used.
# The stub refuses to exist unless NODE_ENV (above) is written explicitly as development or test: with NODE_ENV unset,
# empty or production the API will not start. Default malladmin@gabay.test.
DEV_STUB_USER_EMAIL=malladmin@gabay.test

# ---------------------------------------------------------------------------
# Local file store (EXCEPTIONS E-20; P0-03 D2, AC-50; OA-2). Until the deploy call, uploaded floor-plan images and
# published packages are files in a local folder, never Cloud Storage.
# ---------------------------------------------------------------------------
# The folder the API keeps its stored files in. A relative path is read from the repository root (not from the
# working directory). Keep it inside .gitignore: the default .local-files is ignored, and files there are throwaway
# test data (E-20). Each working copy has its own. Default .local-files.
FILE_STORE_DIR=.local-files
