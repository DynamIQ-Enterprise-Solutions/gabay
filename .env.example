# Gabay — .env.example
# Version 0.1 stub · 2026-10-07 · Phase 0 stub (standard §2; plan.html L115)
# Copy to .env and fill in. The real .env is never committed (the pre-commit hook refuses it, §8.1).
# Keys are added here in the same change that first reads them.

# ---------------------------------------------------------------------------
# Local PostgreSQL (L109, L115). Development only.
# ---------------------------------------------------------------------------
# Host of the local PostgreSQL 18 server. On a deployed function exactly ONE of PGHOST and CLOUD_SQL_INSTANCE (below) is set:
# PGHOST for this machine, the Cloud SQL Auth Proxy (127.0.0.1:<its port>) or the untested /cloudsql/<instance> socket path.
PGHOST=localhost
# Port (the installer's default).
PGPORT=5432
# Database created in INSTALL.md A.1.
PGDATABASE=gabay_dev
# Superuser for local development only. The API gets its own least-privilege login in Phase 1.
PGUSER=postgres
# The password you chose at install. Never commit a real value.
PGPASSWORD=

# ---------------------------------------------------------------------------
# Emulator lane (plan/PH4-lane-ports.md). A coder's working copy runs its Firebase emulators on the default ports plus this
# offset, so copies verify side by side (functions 5001, auth 9099, hub 4400, logging 4500, eventarc 9299, tasks 9499).
# `npm run worktree:new` writes it into the copy's .env. Without it a copy named after an agent uses its table value
# (api-coder 10, flutter-coder 20, engine-coder 30, native-ble 40, test-verifier 50) and any other folder, the main one
# included, uses 0. A whole number from 0 to 99 (the base ports are at least 100 apart, so a larger offset could meet another lane's port); no two copies may share one. `worktree:new` also sets
# FIREBASE_AUTH_EMULATOR_HOST below to 127.0.0.1:<9099 + this offset> in the copy's .env.
# EMULATOR_PORT_OFFSET=10

# ---------------------------------------------------------------------------
# Test accounts (L119). Local Firebase Auth emulator only. One password per account; never commit real values.
# ---------------------------------------------------------------------------
# superadmin@gabay.test: SuperAdmin (platform).
SEED_PW_SUPERADMIN=
# malladmin@gabay.test: Mall admin of both test tenants (the product owner).
SEED_PW_MALLADMIN=
# editor@gabay.test: Venue editor, both tenants.
SEED_PW_EDITOR=
# viewer@gabay.test: Viewer, both tenants.
SEED_PW_VIEWER=
# malladmin.demo@gabay.test: Mall admin of Demo Malls only (tenant isolation).
SEED_PW_MALLADMIN_DEMO=
# shopper@gabay.test: a signed-in shopper.
SEED_PW_SHOPPER=

# ---------------------------------------------------------------------------
# API (Phase 1, functions/src/config). Read once at start-up and validated with zod: a missing
# required key or a malformed value stops the API with a message naming the key (standard §3.16).
# An empty value counts as "not set". A real environment variable always beats this file.
# ---------------------------------------------------------------------------
# Node environment: development | test | production. Default development.
NODE_ENV=development
# Log level for pino: fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=info
# Origins allowed to call the API: the admin web page's address (E-05). Comma-separated, exact match
# (scheme + host + port). EMPTY allows every origin and the API logs a loud warning at start-up:
# never leave it empty in a deployed environment.
CORS_ORIGINS=http://localhost:5000
# How many reverse-proxy hops sit in front of the API (the client IP is read from that far along
# X-Forwarded-For). Cloud Functions sits behind Google's front end: 1. Default 1. Wrong values make
# req.ip lie, which breaks rate limiting.
TRUST_PROXY_HOPS=1
# Largest JSON request body. Default 5mb; never a blanket 50mb (memory-DoS amplifier). Large files go
# through upload routes, not JSON. Format: a number plus b, kb or mb.
MAX_JSON_BODY=5mb
# Rate limits (SEC-2). Counted in memory per client address (req.ip, which TRUST_PROXY_HOPS above decides), so they are
# valid ONLY while the function runs one instance (maxInstances = 1, Blueprint 2.6): a second instance needs a shared
# store first. Each value is a whole number of at least 1; a typo (0, 1.5, abc, or absurdly large) stops start-up and
# names the key. A change needs a restart (a redeploy on Cloud Functions).
# Requests a minute, per client address, under /api. Default 1200 (standard §3.2). Largest 100000.
RATE_LIMIT_PER_MIN=1200
# Failed sign-in checks (401s) a client address may have in one window; the next request, valid token or not, answers 429
# until the window ends. Only a 401 counts: a 400, 403, 404, 409 or an aborted request does not. Default 15. Largest 10000.
AUTH_RATE_LIMIT_MAX=15
# The window of AUTH_RATE_LIMIT_MAX, in minutes. Default 15. Largest 1440.
AUTH_RATE_LIMIT_WINDOW_MIN=15
# on | off. Default on. off stops both limiters and logs one warning; the API REFUSES to start with off unless NODE_ENV is
# written explicitly as development or test (a deployed function keeps its limits).
RATE_LIMIT=on
# Database pool (the PG* keys above say where the database is). All optional.
# Most connections the one function instance opens. Default 10.
PG_POOL_MAX=10
# Close a connection idle this long, in milliseconds. Default 30000.
PG_IDLE_TIMEOUT_MS=30000
# Give up connecting after this long, in milliseconds. Default 5000 (the health check then answers 503).
PG_CONNECT_TIMEOUT_MS=5000
# Longest any one statement may run, in milliseconds. Default 60000: bulk writes and publishes run long.
PG_STATEMENT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Firebase Auth: who signs in (SEC-1, L186). Every admin request carries a Firebase ID token and names its tenant in
# X-Tenant-Id; there is no development stub. Two modes, chosen by these two keys alone (the API logs one start-up line,
# "auth: emulator" or "auth: Firebase project <id>"):
#   EMULATOR (development and tests, the default here): FIREBASE_AUTH_EMULATOR_HOST set. The seeded @gabay.test accounts
#     sign in against the Auth emulator; the project is demo-gabay unless FIREBASE_PROJECT_ID says otherwise.
#   REAL PROJECT (the owner's Spark-plan project, sign-in only; the API and the database stay on this machine):
#     FIREBASE_PROJECT_ID set to the project's id, FIREBASE_AUTH_EMULATOR_HOST EMPTY, and a credential for the revocation
#     check: your own login (`gcloud auth application-default login`, no key file; DEP-0, plan/DEP-0-step0.md row 18) or
#     GOOGLE_APPLICATION_CREDENTIALS. Users are made with `npm run staging:admin -- <email> <role> [<tenant>] --local-db`
#     (INSTALL.md A.7) or in the project's console and mapped by SQL (A.6). Nothing is deployed (L186).
# With both a project id and an emulator host, the emulator wins.
# On a DEPLOYED function none of these FIREBASE_ names is set: Firebase reserves the FIREBASE_ prefix in the deploy's .env file,
# and the Admin SDK takes the project from the runtime (DEP-0 AC-26). These keys are for this machine only.
# ---------------------------------------------------------------------------
# The Firebase project ID. Empty with an emulator host: demo-gabay. Empty with no host: no sign-in works.
FIREBASE_PROJECT_ID=
# The Firebase Auth emulator, development and tests ONLY: host:port the Admin SDK checks ID tokens against
# (the seed starts it on 127.0.0.1:9099). The SDK then accepts UNSIGNED tokens, so the API refuses to start
# with this set unless NODE_ENV is written explicitly as development or test (NODE_ENV above; an unset NODE_ENV
# does not count). Leave it EMPTY for the real project and in any deployed environment: tokens are then checked against
# Google's real certificates for FIREBASE_PROJECT_ID. When you run the Functions emulator together with the Auth
# emulator, it sets this variable itself, so NODE_ENV=development must be in .env.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Real-project mode only: the ABSOLUTE path of the project's service-account key file, kept OUTSIDE the repository and
# never committed, printed or shared (a relative path would be read from whatever folder the API starts in). The
# revocation check every request makes is an Admin API call that needs it; without it every real-project request
# answers 503 "Authentication service unavailable" (SEC-1 step 0 (a)). Leave empty for the emulator.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Local file store (EXCEPTIONS E-20; P0-03 D2, AC-50; OA-2). Until the deploy call, uploaded floor-plan images and
# published packages are files in a local folder, never Cloud Storage.
# ---------------------------------------------------------------------------
# The folder the API keeps its stored files in. A relative path is read from the repository root (not from the
# working directory). Keep it inside .gitignore: the default .local-files is ignored, and files there are throwaway
# test data (E-20). Each working copy has its own. Default .local-files.
FILE_STORE_DIR=.local-files

# ---------------------------------------------------------------------------
# Deploy configuration (DEP-0; spec/DEP-0.md r2). A local run leaves all of this as it is. The deployed values are the runbook's
# environment table (docs/ops/DEPLOYMENT_RUNBOOK.md), in functions/.env.<projectId>, which is never committed.
# ---------------------------------------------------------------------------
# Which store holds the files: local (the folder above; the default) or gcs (one private Cloud Storage bucket, E-09). A deploy
# left at local starts anyway and its uploads are lost: read the start-up line.
FILE_STORE=local
# The bucket name, required with FILE_STORE=gcs.
GCS_BUCKET=
# The Cloud SQL instance connection name <project>:<region>:<instance>: connector mode (E-29). Set it INSTEAD of PGHOST, never
# both and never neither (a ConfigError names both keys). Leave empty here.
CLOUD_SQL_INSTANCE=
# FUNCTIONS_EMULATOR is set to true by the Functions emulator itself, never by hand: the API then uses 127.0.0.1 as the client
# address (the emulator gives it no socket address) and the function does not declare its Secret Manager secret.
